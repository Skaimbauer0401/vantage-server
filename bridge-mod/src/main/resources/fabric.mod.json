{
	"schemaVersion": 1,
	"id": "mcrs-bridge",
	"version": "${version}",
	"name": "mcrs bridge",
	"description": "Connects the Minecraft server to the mcrs Rust core it runs inside.",
	"license": "MIT OR Apache-2.0",
	"environment": "server",
	"entrypoints": {
		"main": [
			"dev.mcrs.bridge.McrsBridge"
		]
	},
	"mixins": [
		"mcrs-bridge.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25"
	}
}
